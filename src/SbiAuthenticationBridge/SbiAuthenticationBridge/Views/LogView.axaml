<UserControl
    d:DesignHeight="300"
    d:DesignWidth="900"
    mc:Ignorable="d"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    x:Class="SbiAuthenticationBridge.Views.LogView"
    x:DataType="viewModels:LogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:viewModels="clr-namespace:SbiAuthenticationBridge.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,12" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,150,*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Text="日志"
                VerticalAlignment="Center" />
            <ComboBox
                Grid.Column="1"
                ItemsSource="{Binding LevelOptions}"
                SelectedItem="{Binding SelectedLevelOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:LogLevelOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox
                Grid.Column="2"
                PlaceholderText="过滤日志内容"
                Text="{Binding FilterText, Mode=TwoWay}" />
            <CheckBox
                Grid.Column="3"
                Content="自动滚动"
                IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="4"
                Command="{Binding ClearCommand}"
                Content="清除" />
            <TextBlock
                Grid.Column="5"
                Opacity="0.65"
                Text="{Binding EntryCountText}"
                VerticalAlignment="Center" />
        </Grid>

        <Border
            BorderBrush="#33808080"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="4"
            Grid.Row="1"
            Margin="0,8,0,0">
            <Panel>
                <ScrollViewer
                    x:Name="LogScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:LogEntryViewModel">
                                <Grid ColumnDefinitions="86,44,*" Margin="8,3">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        Opacity="0.65"
                                        Text="{Binding TimeText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontFamily="Consolas"
                                        Foreground="{Binding LevelBrush}"
                                        Text="{Binding LevelText}" />
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            Text="{Binding Message}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{Binding LevelBrush}"
                                            IsVisible="{Binding HasException}"
                                            Opacity="0.85"
                                            Text="{Binding ExceptionDisplay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !HasEntries}"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.65"
                        Text="暂无日志" />
                    <TextBlock
                        FontSize="11"
                        HorizontalAlignment="Center"
                        Opacity="0.5"
                        Text="{Binding BufferDescription}" />
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>
