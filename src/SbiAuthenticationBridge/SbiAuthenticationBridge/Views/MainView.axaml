<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    x:Class="SbiAuthenticationBridge.Views.MainView"
    x:DataType="vm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:views="clr-namespace:SbiAuthenticationBridge.Views"
    xmlns:vm="using:SbiAuthenticationBridge.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="380,*">
        <views:DevicesView />
        <Border
            BorderBrush="#33808080"
            BorderThickness="1,0,0,0"
            Grid.Column="1">
            <Grid RowDefinitions="Auto,*,4,240">
                <views:ServiceOperateView />
                <views:DeviceOperateView Grid.Row="1" MinHeight="200" />
                <GridSplitter
                    Background="#33808080"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Rows" />
                <Border
                    BorderBrush="#33808080"
                    BorderThickness="0,1,0,0"
                    Grid.Row="3"
                    MinHeight="120">
                    <views:LogView />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>