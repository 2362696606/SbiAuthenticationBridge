<UserControl
    d:DesignHeight="180"
    d:DesignWidth="900"
    mc:Ignorable="d"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    x:Class="SbiAuthenticationBridge.Views.ServiceOperateView"
    x:DataType="viewModels:ServiceOperateViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:viewModels="clr-namespace:SbiAuthenticationBridge.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ServiceControlTemplate" x:DataType="viewModels:SbiServiceControlViewModel">
            <Border
                BorderBrush="#33808080"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding DisplayName}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Opacity="0.7"
                            Text="{Binding StatusText}"
                            VerticalAlignment="Center" />
                        <StackPanel
                            Grid.Column="2"
                            IsVisible="{Binding HasPort}"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock Text="端口" VerticalAlignment="Center" />
                            <NumericUpDown
                                FormatString="0"
                                Increment="1"
                                IsEnabled="{Binding CanEditPort}"
                                Maximum="4600"
                                Minimum="4501"
                                Value="{Binding Port, Mode=TwoWay}"
                                Width="130" />
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Command="{Binding StartCommand}"
                            Content="启动" />
                        <Button
                            Grid.Column="4"
                            Command="{Binding StopCommand}"
                            Content="停止" />
                    </Grid>
                    <TextBlock
                        Foreground="#C62828"
                        IsVisible="{Binding HasPortValidationError}"
                        Text="{Binding PortValidationMessage}" />
                    <TextBlock
                        Foreground="#C62828"
                        IsVisible="{Binding HasError}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="16,12" Spacing="8">
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="服务操作" />
        <ContentControl
            Content="{Binding Authentication}"
            ContentTemplate="{StaticResource ServiceControlTemplate}" />
        <ContentControl
            Content="{Binding Registration}"
            ContentTemplate="{StaticResource ServiceControlTemplate}" />
    </StackPanel>
</UserControl>
