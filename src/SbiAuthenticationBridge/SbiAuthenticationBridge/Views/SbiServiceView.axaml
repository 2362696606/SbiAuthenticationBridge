<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="SbiAuthenticationBridge.Views.SbiServiceView"
    x:DataType="viewModels:SbiServiceViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:SbiAuthenticationBridge.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,*">
        <StackPanel>
            <TextBlock FontSize="18" FontWeight="Bold" Text="SBI 服务" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="Gray"
                Text="Android 对应 Intent 宿主，Desktop 对应 HTTP 宿主。"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,12,0,0"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock
                Text="服务状态："
                VerticalAlignment="Center" />
            <TextBlock
                FontWeight="SemiBold"
                Text="{Binding StateText}"
                VerticalAlignment="Center" />
        </StackPanel>

        <WrapPanel
            Grid.Row="2"
            Margin="0,12,0,0">
            <Button
                Margin="0,0,8,8"
                Command="{Binding StartCommand}"
                Content="启动服务" />
            <Button
                Margin="0,0,8,8"
                Command="{Binding StopCommand}"
                Content="停止服务" />
            <Button
                Margin="0,0,0,8"
                Command="{Binding RefreshServiceCommand}"
                Content="刷新" />
        </WrapPanel>

        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            Foreground="Red"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
