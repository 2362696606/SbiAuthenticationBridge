<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    mvvm:ViewModelLocator.AutoWireViewModel="True"
    x:Class="SbiAuthenticationBridge.Views.DeviceOperateView"
    x:DataType="viewModels:DeviceOperateViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="http://prismlibrary.com/"
    xmlns:viewModels="clr-namespace:SbiAuthenticationBridge.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">
            <Border
                BorderBrush="#33808080"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding !HasSelectedDevice}"
                Padding="24">
                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.65"
                    Text="未选择设备" />
            </Border>

            <StackPanel IsVisible="{Binding HasSelectedDevice}" Spacing="12">
                <Border
                    BorderBrush="#33808080"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock FontWeight="SemiBold" Text="连接" />
                            <ProgressBar
                                Grid.Column="1"
                                IsIndeterminate="True"
                                IsVisible="{Binding IsBusy}"
                                Width="100" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding ConnectCommand}" Content="连接" />
                            <Button Command="{Binding DisconnectCommand}" Content="断开" />
                            <Button Command="{Binding RefreshStateCommand}" Content="刷新状态" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    BorderBrush="#33808080"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="设备状态" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Opacity="0.7" Text="当前状态：" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding CurrentStatusText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                ItemsSource="{Binding StatusOptions}"
                                MinWidth="120"
                                SelectedItem="{Binding SelectedStatusOption}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:DeviceStatusOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Command="{Binding SetStatusCommand}" Content="设置状态" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    BorderBrush="#33808080"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="密钥轮换" />
                        <TextBlock
                            Opacity="0.7"
                            Text="{Binding KeySubjectDescription}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Opacity="0.7"
                            Text="将使用 Device Provider 私钥签发新证书并写入设备，旧密钥会被原子替换。"
                            TextWrapping="Wrap" />
                        <Button
                            Command="{Binding RotateKeyCommand}"
                            Content="轮换密钥"
                            HorizontalAlignment="Left" />
                        <TextBlock
                            Foreground="#C62828"
                            IsVisible="{Binding !IsKeyRotationConfigured}"
                            Text="签发材料未配置，无法轮换密钥。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Background="#1AC62828"
                    CornerRadius="6"
                    IsVisible="{Binding HasError}"
                    Padding="12">
                    <TextBlock
                        Foreground="#C62828"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
